rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    // The profile is authoritative, so old custom claims cannot retain revoked access.
    function activeOperator() { return isAuth() && userDoc().get('status', '') == 'active'; }
    function isSuperUser() { return activeOperator() && userDoc().role == 'superuser'; }
    function belongsToTenant(tenantId) { return activeOperator() && userDoc().get('tenant_id', '') == tenantId; }
    function isOwner(tenantId) { return belongsToTenant(tenantId) && userDoc().role == 'owner'; }
    function isManager(tenantId) { return belongsToTenant(tenantId) && userDoc().role in ['owner', 'staff']; }
    function hasModule(tenantId, module) {
      let profile = userDoc();
      let permissions = profile.get('permissions', {});
      return isSuperUser() || (belongsToTenant(tenantId) && (profile.role == 'owner'
        || permissions.get(module, false) == true
        || (profile.role == 'staff' && permissions.size() == 0 && module in ['dashboard', 'scanner'])));
    }
    function isMemberOf(tenantId) {
      return isAuth() && exists(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid));
    }
    function validPermissions(p) {
      return p is map && p.keys().hasOnly(['dashboard', 'branches', 'members', 'scanner', 'memberships', 'billing', 'reports'])
        && p.values().hasOnly([true, false]);
    }
    function mayChangeModule(previous, next, grants, module) {
      return previous.get(module, false) == next.get(module, false)
        || grants.get(module, grants.size() == 0 && module in ['dashboard', 'scanner']) == true;
    }
    function staffMayEditPermissions(tenantId) {
      let previous = resource.data.get('permissions', {});
      let next = request.resource.data.get('permissions', {});
      let grants = userDoc().get('permissions', {});
      return mayChangeModule(previous, next, grants, 'dashboard') && mayChangeModule(previous, next, grants, 'branches')
        && mayChangeModule(previous, next, grants, 'members') && mayChangeModule(previous, next, grants, 'scanner')
        && mayChangeModule(previous, next, grants, 'memberships') && mayChangeModule(previous, next, grants, 'billing')
        && mayChangeModule(previous, next, grants, 'reports');
    }
    function mayManageUser(userId) {
      let tenantId = resource.data.tenant_id;
      return isAuth() && request.auth.uid != userId && request.resource.data.tenant_id == tenantId
        // Activation and invitation state are owned by the backend. Managers may
        // suspend/reactivate only accounts whose invitation has been accepted.
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
          || (resource.data.status in ['active', 'suspended'] && request.resource.data.status in ['active', 'suspended']
            && (resource.data.get('account_type', '') != 'managed_staff' || resource.data.get('invitation_status', '') == 'accepted')))
        && resource.data.role in ['staff', 'receptionist'] && request.resource.data.role in ['staff', 'receptionist']
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['permissions'])
          || validPermissions(request.resource.data.get('permissions', {})))
        && (((isSuperUser() || isOwner(tenantId)) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'permissions', 'status', 'branch_id']))
          || (isManager(tenantId) && userDoc().role == 'staff' && resource.data.role == 'receptionist'
            && request.resource.data.role == 'receptionist'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['permissions', 'status', 'branch_id'])
            && staffMayEditPermissions(tenantId)));
    }
    function selfProfileEdit(userId) {
      return isAuth() && request.auth.uid == userId && request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['name', 'phone', 'photo_url', 'notification_prefs']);
    }
    function memberSelfEdit() {
      return isAuth() && resource.data.get('uid', '') == request.auth.uid && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'photo_url']);
    }
    function memberDataAccess(tenantId) {
      return hasModule(tenantId, 'members') || hasModule(tenantId, 'scanner') || hasModule(tenantId, 'memberships')
        || hasModule(tenantId, 'dashboard') || hasModule(tenantId, 'reports');
    }
    function branchDataAccess(tenantId) { return hasModule(tenantId, 'branches') || memberDataAccess(tenantId) || isManager(tenantId); }
    match /users/{userId} {
      allow read: if isSuperUser() || (isAuth() && request.auth.uid == userId) || isManager(resource.data.tenant_id);
      allow create: if (isSuperUser() && request.resource.data.get('account_type', '') != 'managed_staff') || (isAuth() && request.auth.uid == userId && request.resource.data.role == 'owner'
        && request.resource.data.status == 'active'
        && get(/databases/$(database)/documents/tenants/$(request.resource.data.tenant_id)).data.owner_uid == userId);
      allow update: if (isSuperUser() && resource.data.get('account_type', '') != 'managed_staff') || selfProfileEdit(userId) || mayManageUser(userId);
      allow delete: if isSuperUser() && resource.data.get('account_type', '') != 'managed_staff';
    }
    // Tokens, contact deduplication and recovery throttles are server-only.
    match /staff_invitations/{id} { allow read, write: if false; }
    match /staff_account_keys/{id} { allow read, write: if false; }
    match /staff_recovery_limits/{id} { allow read, write: if false; }
    match /staff_recovery_accounts/{id} { allow read, write: if false; }
    match /subscription_packages/{packageId} { allow read: if isAuth(); allow write: if false; }
    match /tenant_invoices/{invoiceId} { allow read: if isSuperUser() || isOwner(resource.data.tenant_id); allow write: if false; }
    match /{path=**}/members/{memberId} { allow read: if isAuth() && resource.data.get('uid', '') == request.auth.uid; }
    match /{path=**}/check_ins/{checkInId} { allow read: if isAuth() && resource.data.member_id == request.auth.uid; }
    match /tenants/{tenantId} {
      allow read: if isSuperUser() || belongsToTenant(tenantId) || isMemberOf(tenantId);
      allow create: if isSuperUser() || (isAuth() && request.resource.data.owner_uid == request.auth.uid
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid)));
      allow update: if isSuperUser() || (isOwner(tenantId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'settings']));
      allow delete: if isSuperUser();
      match /branches/{branchId} {
        allow read: if branchDataAccess(tenantId) || isMemberOf(tenantId);
        allow write: if hasModule(tenantId, 'branches');
        match /check_ins/{checkInId} {
          allow read: if hasModule(tenantId, 'scanner') || hasModule(tenantId, 'dashboard') || hasModule(tenantId, 'reports')
            || (isAuth() && resource.data.member_id == request.auth.uid);
          allow create: if hasModule(tenantId, 'scanner') || (isAuth() && request.resource.data.member_id == request.auth.uid && isMemberOf(tenantId));
          allow update, delete: if false;
        }
      }
      match /members/{memberId} {
        allow read: if memberDataAccess(tenantId) || (isAuth() && request.auth.uid == memberId);
        allow create, delete: if hasModule(tenantId, 'members');
        allow update: if hasModule(tenantId, 'members') || memberSelfEdit() || (hasModule(tenantId, 'memberships')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plan_id', 'expiration_date', 'access_status']));
      }
      match /membership_plans/{planId} {
        allow read: if hasModule(tenantId, 'memberships') || hasModule(tenantId, 'reports') || isMemberOf(tenantId);
        allow write: if hasModule(tenantId, 'memberships');
      }
      match /payments/{paymentId} {
        allow read: if hasModule(tenantId, 'memberships') || hasModule(tenantId, 'reports') || (isAuth() && request.auth.uid == resource.data.member_id);
        allow create, update: if hasModule(tenantId, 'memberships');
        allow delete: if isSuperUser();
      }
      match /facturas/{facturaId} {
        allow read: if hasModule(tenantId, 'billing') || isMemberOf(tenantId);
        allow write: if false;
      }
    }
  }
}
