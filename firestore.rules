rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ────────────────────────────────────────────────────────────

    function claims() { return request.auth.token; }
    function isAuth() { return request.auth != null; }

    // Devuelve el doc /users/{uid} del usuario autenticado (cacheado por Firestore).
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // True cuando onUserWritten ya corrió y puso custom claims.
    function hasClaims() {
      return 'role' in request.auth.token;
    }

    // Funciones de rol con fallback a Firestore cuando no hay claims.
    function isSuperUser() {
      return isAuth() && (
        claims().role == 'superuser' ||
        (!hasClaims() && userDoc().role == 'superuser')
      );
    }

    function isOwner(tenantId) {
      return isAuth() && (
        (claims().role == 'owner' && claims().tenant_id == tenantId) ||
        (!hasClaims() &&
          userDoc().role == 'owner' &&
          userDoc().tenant_id == tenantId)
      );
    }

    function isStaff(tenantId, branchId) {
      return isAuth() && (
        (claims().role == 'staff' &&
          claims().tenant_id == tenantId &&
          claims().branch_id == branchId) ||
        (!hasClaims() &&
          userDoc().role == 'staff' &&
          userDoc().tenant_id == tenantId &&
          userDoc().branch_id == branchId)
      );
    }

    function belongsToTenant(tenantId) {
      return isAuth() && (
        claims().tenant_id == tenantId ||
        (!hasClaims() && userDoc().tenant_id == tenantId)
      );
    }

    function canManageBranch(tenantId, branchId) {
      return isSuperUser()
          || isOwner(tenantId)
          || isStaff(tenantId, branchId);
    }

    // True si el usuario autenticado es un socio de este tenant: tiene doc en
    // tenants/{tenantId}/members/{uid} (el ID del doc == su uid de Auth).
    // No depende de custom claims, así que funciona en el primer login.
    function isMemberOf(tenantId) {
      return isAuth() &&
        exists(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid));
    }

    // ─── Members: collection group (portal del socio) ───────────────────────
    // Permite que un socio encuentre/lea su propio doc sin conocer el tenantId,
    // vía collectionGroup('members').where('uid', isEqualTo: auth.uid).
    // Filtra por el campo `uid` (no por el ID del doc) para que la query de
    // collection group sea válida, y no depende de custom claims, así que
    // funciona en el primer login (antes de que el token refresque los claims).
    match /{path=**}/members/{memberId} {
      allow read: if isAuth() && resource.data.uid == request.auth.uid;
    }

    // ─── Users (operadores del sistema) ─────────────────────────────────────

    match /users/{userId} {
      allow read: if isSuperUser()
          || (isAuth() && request.auth.uid == userId)
          || (isAuth() && claims().role == 'owner'
              && claims().tenant_id == resource.data.tenant_id)
          || (isAuth() && !hasClaims()
              && userDoc().role == 'owner'
              && userDoc().tenant_id == resource.data.tenant_id);

      // Bootstrap: el usuario puede crear su propio doc sin claims (registro de owner)
      allow create: if isSuperUser()
          || (isAuth() && request.auth.uid == userId
              && request.resource.data.role == 'owner')
          || (isAuth() && claims().role == 'owner'
              && claims().tenant_id == request.resource.data.tenant_id);

      allow update: if isSuperUser()
          || (isAuth() && claims().role == 'owner'
              && claims().tenant_id == resource.data.tenant_id)
          || (isAuth() && !hasClaims()
              && userDoc().role == 'owner'
              && userDoc().tenant_id == resource.data.tenant_id);

      allow delete: if isSuperUser();
    }

    // ─── Tenants ────────────────────────────────────────────────────────────

    match /tenants/{tenantId} {
      // El socio lee su gym (logo/nombre) vía isMemberOf.
      allow read:   if isSuperUser() || belongsToTenant(tenantId) || isMemberOf(tenantId);
      // Bootstrap: usuario autenticado sin tenant_id puede crear su tenant
      allow create: if isSuperUser()
          || (isAuth() && !('tenant_id' in request.auth.token));
      allow update: if isSuperUser() || isOwner(tenantId);
      allow delete: if isSuperUser();

      // ─── Branches ───────────────────────────────────────────────────────

      match /branches/{branchId} {
        // El socio lee las sucursales de su gym (QR / check-in GPS) vía isMemberOf.
        allow read:           if isSuperUser() || belongsToTenant(tenantId) || isMemberOf(tenantId);
        allow create, update: if isSuperUser() || isOwner(tenantId);
        allow delete:         if isSuperUser() || isOwner(tenantId);

        // Check-ins: log inmutable — solo append.
        // Personal operativo lee todos; el socio lee y crea solo los suyos.
        match /check_ins/{checkInId} {
          allow read:           if canManageBranch(tenantId, branchId)
              || (isAuth() && resource.data.member_id == request.auth.uid);
          allow create:         if (isAuth() && belongsToTenant(tenantId))
              || (isAuth() && request.resource.data.member_id == request.auth.uid);
          allow update, delete: if false;
        }
      }

      // ─── Members ────────────────────────────────────────────────────────

      match /members/{memberId} {
        allow read: if isSuperUser()
            || isOwner(tenantId)
            || (isAuth() && claims().tenant_id == tenantId
                && claims().branch_id in resource.data.allowed_branches)
            || (isAuth() && !hasClaims()
                && userDoc().tenant_id == tenantId
                && userDoc().role == 'staff'
                && userDoc().branch_id in resource.data.allowed_branches)
            || (isAuth() && request.auth.uid == memberId);

        allow create: if isSuperUser()
            || isOwner(tenantId)
            || isStaff(tenantId, request.resource.data.allowed_branches[0]);

        allow update: if isSuperUser()
            || isOwner(tenantId)
            || isStaff(tenantId, resource.data.allowed_branches[0]);

        allow delete: if isSuperUser() || isOwner(tenantId);
      }

      // ─── Membership Plans ───────────────────────────────────────────────

      match /membership_plans/{planId} {
        // El socio lee los planes de su gym vía isMemberOf.
        allow read:  if (isAuth() && belongsToTenant(tenantId)) || isMemberOf(tenantId);
        allow write: if isSuperUser() || isOwner(tenantId);
      }

      // ─── Payments ───────────────────────────────────────────────────────

      match /payments/{paymentId} {
        allow read: if isSuperUser()
            || isOwner(tenantId)
            || isStaff(tenantId, resource.data.branch_id)
            || (isAuth() && request.auth.uid == resource.data.member_id);

        allow create: if isAuth() && belongsToTenant(tenantId);
        allow update: if isSuperUser()
            || isOwner(tenantId)
            || isStaff(tenantId, resource.data.branch_id);
        allow delete: if isSuperUser();
      }
    }
  }
}
