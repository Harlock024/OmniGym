rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ────────────────────────────────────────────────────────────

    function claims() { return request.auth.token; }
    function isAuth() { return request.auth != null; }

    function isSuperUser() {
      return isAuth() && claims().role == 'superuser';
    }

    function isOwner(tenantId) {
      return isAuth()
          && claims().role == 'owner'
          && claims().tenant_id == tenantId;
    }

    function isStaff(tenantId, branchId) {
      return isAuth()
          && claims().role == 'staff'
          && claims().tenant_id == tenantId
          && claims().branch_id == branchId;
    }

    function belongsToTenant(tenantId) {
      return isAuth() && (
        claims().tenant_id == tenantId ||
        // Fallback cuando onUserWritten no ha asignado claims aún
        (!('tenant_id' in request.auth.token) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenant_id == tenantId)
      );
    }

    function canManageBranch(tenantId, branchId) {
      return isSuperUser()
          || isOwner(tenantId)
          || isStaff(tenantId, branchId);
    }

    // ─── Users (operadores del sistema) ─────────────────────────────────────

    match /users/{userId} {
      // Cualquier usuario autenticado puede leer su propio perfil
      allow read: if isSuperUser()
          || (isAuth() && request.auth.uid == userId)
          || (isAuth() && claims().tenant_id == resource.data.tenant_id
              && claims().role == 'owner');

      // Bootstrap: el usuario puede crear su propio doc en el registro (sin claims aún)
      // Staff y managers los crea el owner o superuser
      allow create: if isSuperUser()
          || (isAuth() && request.auth.uid == userId
              && request.resource.data.role == 'owner')
          || (isAuth() && claims().role == 'owner'
              && claims().tenant_id == request.resource.data.tenant_id);

      allow update: if isSuperUser()
          || (isAuth() && claims().role == 'owner'
              && claims().tenant_id == resource.data.tenant_id);

      allow delete: if isSuperUser();
    }

    // ─── Tenants ────────────────────────────────────────────────────────────

    match /tenants/{tenantId} {
      allow read:   if isSuperUser() || belongsToTenant(tenantId);
      // Bootstrap: usuario autenticado sin claims puede crear su tenant en el registro
      allow create: if isSuperUser()
          || (isAuth() && !('tenant_id' in request.auth.token));
      allow update: if isSuperUser() || isOwner(tenantId);
      allow delete: if isSuperUser();

      // ─── Branches ───────────────────────────────────────────────────────

      match /branches/{branchId} {
        allow read:           if isSuperUser() || belongsToTenant(tenantId);
        allow create, update: if isSuperUser() || isOwner(tenantId);
        allow delete:         if isSuperUser() || isOwner(tenantId);

        // Check-ins: log inmutable — solo append para personal operativo
        match /check_ins/{checkInId} {
          allow read:           if canManageBranch(tenantId, branchId);
          allow create:         if isAuth() && belongsToTenant(tenantId);
          allow update, delete: if false;
        }
      }

      // ─── Members ────────────────────────────────────────────────────────

      match /members/{memberId} {
        allow read: if isSuperUser()
            || isOwner(tenantId)
            || (isAuth() && claims().tenant_id == tenantId
                && claims().branch_id in resource.data.allowed_branches)
            || (isAuth() && request.auth.uid == memberId);

        allow create: if isSuperUser()
            || isOwner(tenantId)
            || isStaff(tenantId, request.resource.data.allowed_branches[0]);

        allow update: if isSuperUser()
            || isOwner(tenantId)
            || isStaff(tenantId, resource.data.allowed_branches[0]);

        allow delete: if isSuperUser() || isOwner(tenantId);
      }

      // ─── Membership Plans ───────────────────────────────────────────────

      match /membership_plans/{planId} {
        allow read:  if isAuth() && belongsToTenant(tenantId);
        allow write: if isSuperUser() || isOwner(tenantId);
      }

      // ─── Payments ───────────────────────────────────────────────────────

      match /payments/{paymentId} {
        allow read: if isSuperUser()
            || isOwner(tenantId)
            || isStaff(tenantId, resource.data.branch_id)
            || (isAuth() && request.auth.uid == resource.data.member_id);

        allow create: if isAuth() && belongsToTenant(tenantId);
        allow update: if isSuperUser()
            || isOwner(tenantId)
            || isStaff(tenantId, resource.data.branch_id);
        allow delete: if isSuperUser();
      }
    }
  }
}
